    { "src": "/admin-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Orders", "url": "/admin/orders", "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192" }] },
    { "name": "Abandoned checkouts", "url": "/admin/abandoned", "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192" }] }
  ]
}
