# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Analytics ---
# Google Analytics 4 measurement ID (Admin → Data streams → Web)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Microsoft Clarity project ID (Settings → Overview → Project ID)
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# --- Store details ---
NEXT_PUBLIC_STORE_NAME=Homiqo
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
NEXT_PUBLIC_CONTACT_PHONE=+92 300 0000000
NEXT_PUBLIC_CONTACT_EMAIL=support@yourdomain.com
# WhatsApp number in international format without + (enables floating chat button)
NEXT_PUBLIC_WHATSAPP=923000000000

# --- Order emails (SMTP) ---
# Hostinger email: host smtp.hostinger.com, port 465, user = full mailbox address
# Gmail: host smtp.gmail.com, port 465, user = gmail address, pass = 16-char App Password
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=orders@homiqo.site
SMTP_PASS=your-mailbox-password
SMTP_FROM=Homiqo <orders@homiqo.site>
# Where new-order alerts go (your own inbox)
ADMIN_NOTIFY_EMAIL=you@example.com

# Meta (Facebook) Pixel ID — Events Manager → Data sources → your pixel
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# --- Meta Ads reporting (admin → Marketing). Server-only, never exposed to the browser ---
META_AD_ACCOUNT_ID=act_1234567890
META_ACCESS_TOKEN=your-system-user-token-with-ads_read
